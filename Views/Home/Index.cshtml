<!-- =========================================================
     ENGENHARIA LUMINOTÉCNICA
     ========================================================= -->

<section class="engineering-section" id="engenharia">

    <div class="engineering-container">

        <div class="engineering-content">

            <div class="section-eyebrow engineering-eyebrow">
                <span></span>
                ENGENHARIA E PROJETOS
            </div>

            <h2>
                Não vendemos apenas luminárias.
                <strong>Projetamos soluções de iluminação.</strong>
            </h2>

            <p class="engineering-intro">
                Cada projeto da Brightlux é desenvolvido para entregar
                eficiência, segurança, conforto visual e o melhor
                aproveitamento da iluminação.
            </p>

            <p>
                Nossa equipe realiza estudos luminotécnicos personalizados,
                considerando as características do ambiente, atividade,
                altura, distribuição dos pontos de luz e níveis de
                iluminância necessários.
            </p>

            <div class="engineering-benefits">

                <div class="engineering-benefit">
                    <div class="benefit-icon">01</div>

                    <div>
                        <strong>Estudo personalizado</strong>

                        <span>
                            Análise das características e necessidades
                            específicas de cada projeto.
                        </span>
                    </div>
                </div>


                <div class="engineering-benefit">
                    <div class="benefit-icon">02</div>

                    <div>
                        <strong>Eficiência energética</strong>

                        <span>
                            Soluções desenvolvidas para otimizar o consumo
                            e o desempenho da iluminação.
                        </span>
                    </div>
                </div>


                <div class="engineering-benefit">
                    <div class="benefit-icon">03</div>

                    <div>
                        <strong>Melhor distribuição da luz</strong>

                        <span>
                            Posicionamento estratégico para obter
                            uniformidade e melhor aproveitamento luminoso.
                        </span>
                    </div>
                </div>

            </div>


            <a href="#contato" class="btn btn-primary engineering-button">
                Fale com um especialista
                <span>→</span>
            </a>

        </div>


        <div class="engineering-visual">

            <div class="engineering-image">

                <img
                    src="/images/engenharia/estudo-luminotecnico.jpg"
                    alt="Estudo luminotécnico e projeto de iluminação Brightlux"
                >

                <div class="engineering-overlay"></div>

            </div>


            <!-- Indicador técnico -->

            <div class="engineering-data engineering-data-top">

                <span class="data-line"></span>

                <div>
                    <strong>Distribuição luminosa</strong>
                    <small>Otimização do projeto</small>
                </div>

            </div>


            <div class="engineering-data engineering-data-bottom">

                <span class="data-line"></span>

                <div>
                    <strong>Projeto personalizado</strong>
                    <small>Desenvolvido para cada ambiente</small>
                </div>

            </div>


            <div class="engineering-badge">

                <span class="badge-number">01</span>

                <div>
                    <strong>Engenharia</strong>
                    <small>luminotécnica</small>
                </div>

            </div>

        </div>

    </div>

</section>

<!-- =========================================================
     PRODUTOS
========================================================= -->

<section class="products-section" id="produtos">

    <div class="products-container">

        <div class="products-header">

            <div>

                <div class="section-eyebrow">

                    <span></span>

                    NOSSAS SOLUÇÕES

                </div>

                <h2>
                    Produtos desenvolvidos
                    <span>para alta performance.</span>
                </h2>

            </div>

            <a asp-controller="Product" asp-action="Index"
               class="products-catalog-link">

                Ver catálogo completo
                <span>→</span>

            </a>

        </div>


        <p class="products-intro">
            Soluções de iluminação desenvolvidas para diferentes
            aplicações, com foco em eficiência, desempenho e
            durabilidade.
        </p>


        <!-- PRODUTOS VINDOS DO BANCO -->

        @if (Model != null && Model.Any())
        {
            <div class="products-grid">

                @foreach (var product in Model)
                {
                    <article class="product-card">

                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id"
                           class="product-image">

                            @if (!string.IsNullOrWhiteSpace(product.Imagem))
                            {
                                <img src="@product.Imagem"
                                     alt="@product.Nome"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="product-image-placeholder">
                                    <span>Imagem indisponível</span>
                                </div>
                            }

                        </a>


                        <div class="product-content">

                            <div class="product-category">
                                @product.Categoria
                            </div>

                            <h3>
                                @product.Nome
                            </h3>

                            <p>
                                @product.Descricao
                            </p>

                            <div class="product-footer">

                                <span>
                                    @product.Aplicacao
                                </span>

                                <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id"
                                   aria-label="Ver detalhes de @product.Nome">

                                    →

                                </a>

                            </div>

                        </div>

                    </article>
                }

            </div>
        }
        else
        {
            <div class="products-empty">

                <p>
                    Em breve apresentaremos nossas principais
                    soluções de iluminação.
                </p>

            </div>
        }


        <div class="products-bottom">

            <a asp-controller="Product" asp-action="Index"
               class="primary-button">

                Conheça todos os produtos

                <span>→</span>

            </a>

        </div>

    </div>

</section>

