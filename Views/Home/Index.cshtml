@{
    ViewData["Title"] = "Soluções em Iluminação";
}


<section class="hero" id="inicio">

    <!-- Imagem/Fundo -->
    <div class="hero-background"></div>

    <!-- Overlay -->
    <div class="hero-overlay"></div>


    <div class="hero-container">

        <div class="hero-content">

            <!-- Pequeno destaque -->

            <div class="hero-eyebrow">

                <span class="eyebrow-line"></span>

                SOLUÇÕES COMPLETAS EM ILUMINAÇÃO

            </div>


            <!-- TÍTULO -->

            <h1 class="hero-title">

                Iluminação que
                <span>transforma</span>
                grandes espaços.

            </h1>


            <!-- DESCRIÇÃO -->

            <p class="hero-description">

                Projetamos soluções de iluminação eficientes,
                duráveis e sob medida para indústrias,
                empresas, cidades e grandes projetos.

            </p>


            <!-- BOTÕES -->

            <div class="hero-actions">

                <a href="#solucoes" class="button button-primary">

                    Conheça nossas soluções

                    <span>→</span>

                </a>


                <a href="#contato" class="button button-secondary">

                    Fale com um especialista

                    <span>↗</span>

                </a>

            </div>

        </div>


        <!-- INDICADORES -->

        <div class="hero-stats">

            <div class="hero-stat">

                <strong>15+</strong>

                <span>
                    anos de experiência
                </span>

            </div>


            <div class="hero-stat">

                <strong>Fábrica</strong>

                <span>
                    própria na China
                </span>

            </div>


            <div class="hero-stat">

                <strong>Projetos</strong>

                <span>
                    personalizados
                </span>

            </div>


            <div class="hero-stat">

                <strong>Suporte</strong>

                <span>
                    especializado no Brasil
                </span>

            </div>

        </div>

    </div>


    <!-- INDICADOR DE SCROLL -->

    <a href="#solucoes" class="hero-scroll">

        <span class="hero-scroll-line"></span>

        <span>Explorar</span>

        <span class="hero-scroll-arrow">↓</span>

    </a>

</section>