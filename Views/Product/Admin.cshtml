@model IReadOnlyList<Brightlux.Models.Product>

@{
    ViewData["Title"] = "Administração de produtos";
}

<section class="product-admin">
    <div class="product-admin__container">
        <header class="product-admin__header">
            <div>
                <span class="section-eyebrow">CATÁLOGO</span>
                <h1>Produtos</h1>
                <p>Cadastre e organize os produtos exibidos no site.</p>
            </div>
            <div class="product-admin__tools">
                <a asp-action="Create" class="admin-button admin-button--primary">Novo produto</a>
                <form asp-controller="Admin" asp-action="Logout" method="post">
                    <button type="submit" class="admin-button">Sair</button>
                </form>
            </div>
        </header>

        @if (TempData["Success"] is string message)
        {
            <div class="admin-alert" role="status">@message</div>
        }

        @if (Model.Count == 0)
        {
            <div class="admin-empty">
                <h2>Nenhum produto cadastrado</h2>
                <p>Crie o primeiro item para começar a montar o catálogo.</p>
            </div>
        }
        else
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Ordem</th>
                            <th>Produto</th>
                            <th>Categoria</th>
                            <th>Status</th>
                            <th>Destaque</th>
                            <th class="admin-table__actions">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td>@product.Ordem</td>
                                <td>
                                    <div class="admin-product">
                                        @if (!string.IsNullOrWhiteSpace(product.Imagem))
                                        {
                                            <img src="@product.Imagem" alt="" />
                                        }
                                        <div>
                                            <strong>@product.Nome</strong>
                                            <small>@product.Aplicacao</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@product.Categoria</td>
                                <td><span class="admin-badge @(product.Ativo ? "is-active" : "is-inactive")">@(product.Ativo ? "Ativo" : "Inativo")</span></td>
                                <td>@(product.Destaque ? "Sim" : "Não")</td>
                                <td class="admin-table__actions">
                                    <a asp-action="Edit" asp-route-id="@product.Id" class="admin-button">Editar</a>
                                    <form asp-action="Delete" asp-route-id="@product.Id" method="post" onsubmit="return confirm('Excluir o produto @product.Nome? Esta ação não pode ser desfeita.');">
                                        <button type="submit" class="admin-button admin-button--danger">Excluir</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
